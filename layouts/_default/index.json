{{- $.Scratch.Delete "search" -}}
{{- $.Scratch.Set "search" slice -}}
{{- $sections := where site.RegularPages "Section" "in" site.Params.mainSections -}}
{{- range $sections -}}
  {{- $.Scratch.Add "search" (dict "title" .Title "date" .Date "description" .Description "permalink" .RelPermalink "tags" .Params.tags "categories" .Params.categories) -}}
{{- end -}}
{{- $.Scratch.Get "search" | jsonify -}}